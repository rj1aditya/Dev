FROM node:latest

COPY index.js /home/app/index.js
COPY package.json /home/app/package.json

#OR
#COPY . /home/app ##THIS WILL COPY ALL THE FILES IN THE CURRENT DIRECTORY TO THE CONTAINER
##BUT THIS WILL COPY ALL THE FILES IN THE CURRENT DIRECTORY TO THE CONTAINER INCLUDING THE NODE_MODULES FOLDER WHICH IS NOT REQUIRED IN THE CONTAINER AND IT WILL INCREASE THE SIZE OF THE IMAGE
##SO IT IS BETTER TO COPY ONLY THE REQUIRED FILES TO THE CONTAINER
##TO AVOID COPYING UNNECESSARY FILES TO THE CONTAINER WE CAN USE .dockerignore FILE TO SPECIFY THE FILES AND FOLDERS THAT WE WANT TO EXCLUDE FROM THE COPY PROCESS
WORKDIR /home/app

RUN npm install
EXPOSE 9000
CMD ["node", "index.js"]

