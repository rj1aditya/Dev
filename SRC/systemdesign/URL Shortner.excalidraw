      "isDeleted": false,
      "boundElements": null,
      "updated": 1774938527990,
      "link": null,
      "locked": false,
      "text": "POST /api/urls/shorten\nreq: Long URL\nres: Short URL\n\nGET /api/urls/{shortURL}\nres: Redirect 301 [note: redirect will include the long url, but redirect is specifically handle by browser with 300 status code, and 301 says to store in the cache, \n                        so next time it will not hit the api. \n                        A \"301 redirect\" in HTTP means that a resource has been permanently moved to a new URL, \n                        and browsers or search engines should update their records to point to the new location. \n                        It’s the standard way to tell both users and search engines that a page has shifted permanently.]\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /api/urls/shorten\nreq: Long URL\nres: Short URL\n\nGET /api/urls/{shortURL}\nres: Redirect 301 [note: redirect will include the long url, but redirect is specifically handle by browser with 300 status code, and 301 says to store in the cache, \n                        so next time it will not hit the api. \n                        A \"301 redirect\" in HTTP means that a resource has been permanently moved to a new URL, \n                        and browsers or search engines should update their records to point to the new location. \n                        It’s the standard way to tell both users and search engines that a page has shifted permanently.]\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
